# Скопируйте в .env.local для разработки.
# На Vercel: Project → Settings → Environment Variables (Production + Preview).

# Обязательно для формы обратной связи
RESEND_API_KEY=re_xxxxxxxx

# Куда приходят заявки с формы
CONTACT_TO_EMAIL=anonymous833420@gmail.com

# Пока домен не подключён в Resend — только onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
# CONTACT_FROM_NAME=Открытая сцена

# Email и URL на сайте (NEXT_PUBLIC_* — нужен redeploy после изменения)
NEXT_PUBLIC_CONTACT_EMAIL=anonymous833420@gmail.com
NEXT_PUBLIC_SITE_URL=https://opnstage.ru

# Админ-панель (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=задайте-надёжный-пароль
# Случайная строка минимум 16 символов (openssl rand -base64 32)
ADMIN_SESSION_SECRET=замените-на-случайную-строку-32-символа
# Опционально: bcrypt-хеш пароля вместо ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# Vercel Blob — хранение CMS и загрузок на продакшене
# Vercel → Storage → Create Blob Store → подключить к проекту → Redeploy
# Локально без токена используется data/cms/ и public/uploads/
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
